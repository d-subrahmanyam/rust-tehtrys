<?xml version="1.0" encoding="UTF-8"?>
<!-- cargo-wix .msi. `cargo install cargo-wix && cargo wix`. NOT verified. WiX v3. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="tehtrys" Language="1033" Version="1.0.2" Manufacturer="d-subrahmanyam"
           UpgradeCode="11111111-2222-3333-4444-555555555555">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="ProductFeature" Title="tehtrys" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
    <!-- non-commercial CC-BY-NC; not affiliated The Tetris Company -->
  </Product>
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="tehtrys">
          <Directory Id="KOROBEINIKI_DIR" Name="assets">
            <Directory Id="KOROBEINIKI_AUDIO" Name="audio" />
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="tehtrys" />
      </Directory>
    </Directory>
  </Fragment>
  <Fragment>
    <!-- `ComponentGroup/@Directory` cannot be combined with `Component/@Directory`;
         put `Directory` on each `Component` instead. -->
    <ComponentGroup Id="ProductComponents">
      <Component Id="TehtrysExe" Guid="*" Win64="yes" Directory="INSTALLFOLDER">
        <File Id="tehtrys.exe" Source="$(var.CargoTargetBinDir)\tehtrys.exe" KeyPath="yes" />
      </Component>
      <Component Id="KorobeinikiWav" Guid="*" Win64="yes" Directory="KOROBEINIKI_AUDIO">
        <File Id="korobeiniki.wav" Source="assets\audio\korobeiniki.wav" KeyPath="yes" />
      </Component>
      <Component Id="KorobeinikiCredits" Guid="*" Win64="yes" Directory="KOROBEINIKI_AUDIO">
        <File Id="KorobeinikiCreditsFile" Source="assets\audio\CREDITS.md" KeyPath="yes" />
      </Component>
      <Component Id="License" Guid="*" Win64="yes" Directory="INSTALLFOLDER">
        <File Id="LICENSE" Source="LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="StartMenuShortcut" Guid="*" Win64="yes" Directory="ApplicationProgramsFolder">
        <Shortcut Id="TehtrysStartMenuShortcut"
                  Name="tehtrys"
                  Description="Faithful 2009 Tetris Guideline clone (non-commercial educational)"
                  Target="[INSTALLFOLDER]tehtrys.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\d-subrahmanyam\tehtrys"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
